[Unit]
Description=Voting app (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/voting_proxy
EnvironmentFile=/home/ec2-user/voting_proxy/.env
# The database runs on another instance. Wait until it answers before starting
# gunicorn so we do not crash-loop while that instance is still booting.
TimeoutStartSec=330
ExecStartPre=/home/ec2-user/voting_proxy/.venv/bin/python /home/ec2-user/voting_proxy/scripts/wait_for_dynamodb.py --timeout 300
ExecStart=/home/ec2-user/voting_proxy/.venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 'voting.app:launch()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
